{
  "name": "easydrive-server",
  "version": "1.0.0",
  "description": "EasyDrive backend — Express REST API with MongoDB, JWT, and Zod validation",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch --watch-path=config --watch-path=middleware --watch-path=models --watch-path=routes --watch-path=utils index.js",
    "seed": "node seed/seedCars.js",
    "test": "node --test tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}

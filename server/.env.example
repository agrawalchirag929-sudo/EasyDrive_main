# EasyDrive Server — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file.

# ── Server ────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/easydrive
MONGODB_URI=mongodb://localhost:27017/easydrive

# ── JSON Web Token ────────────────────────────────────────
# Use a long random string (e.g. 64+ hex chars). Never share this value.
JWT_SECRET=replace_with_a_long_random_secret

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed client origins.
# For local dev, keep it as shown. Add your deployed URL in production.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Pricing ───────────────────────────────────────────────
# Indian GST rate on rentals (18% = 0.18)
TAX_RATE=0.18
